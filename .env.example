# Cloudflare Worker & Backend Environment Variables
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio
GEMINI_MODEL=gemini-1.5-flash
JWT_SECRET=super_secret_jwt_and_session_signing_salt_minimum_32_chars
ENVIRONMENT=production
ADMIN_BOOTSTRAP_SECRET=secure_admin_initialization_secret_phrase

# Public Frontend Environment Variables
NEXT_PUBLIC_APP_NAME="Haven Mental Wellness"
NEXT_PUBLIC_API_URL="http://localhost:8787"
# In production, set NEXT_PUBLIC_API_URL to your Cloudflare Worker URL, e.g. https://haven-api.<your-subdomain>.workers.dev
